              "critical"
            ],
            "nullable": true,
            "type": "string"
          },
          "threshold_value": {
            "nullable": true,
            "type": "number"
          }
        },
        "required": [
          "reason",
          "penalty",
          "anomaly_type",
          "severity",
          "observed_value",
          "threshold_value",
          "event_time"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": true,
        "properties": {
          "service": {
            "enum": [
              "signalguard-rs"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "type": "object"
      },
      "MarketHealthResponse": {
        "additionalProperties": true,
        "properties": {
          "base_score": {
            "type": "integer"
          },
          "evaluated_at": {
            "format": "date-time",
            "type": "string"
          },
          "penalties": {
            "items": {
              "$ref": "#/components/schemas/HealthPenalty"
