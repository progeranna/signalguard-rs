{
  "components": {
    "schemas": {
      "AnomaliesResponse": {
        "additionalProperties": true,
        "properties": {
          "anomalies": {
            "items": {
              "$ref": "#/components/schemas/AnomalyResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "anomalies"
        ],
        "type": "object"
      },
      "AnomalyResponse": {
        "additionalProperties": true,
        "properties": {
          "anomaly_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "event_time": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "observed_value": {
            "nullable": true,
            "type": "number"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "threshold_value": {
            "nullable": true,
            "type": "number"
          }
        },
        "required": [
          "id",
          "symbol",
          "anomaly_type",
          "severity",
          "message",
          "observed_value",
          "threshold_value",
          "event_time",
          "created_at"
