          },
          "last_event_time": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "last_ingest_time": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "last_trade_price": {
            "description": "rust_decimal JSON serialization",
            "nullable": true,
            "type": "string"
          },
          "last_trade_quantity": {
            "description": "rust_decimal JSON serialization",
            "nullable": true,
            "type": "string"
          },
          "price_change_1m_pct": {
            "nullable": true,
            "type": "number"
          },
          "spread_pct": {
            "nullable": true,
            "type": "number"
          },
          "symbol": {
            "type": "string"
          },
          "top_ask_liquidity": {
            "description": "rust_decimal JSON serialization",
            "nullable": true,
            "type": "string"
          },
          "top_ask_quantity": {
            "description": "rust_decimal JSON serialization",
            "nullable": true,
            "type": "string"
          },
          "top_bid_liquidity": {
            "description": "rust_decimal JSON serialization",
