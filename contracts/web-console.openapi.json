        "required": [
          "last_trade_price",
          "best_bid_price",
          "best_ask_price",
          "spread_pct",
          "price_change_1m_pct",
          "trades_per_minute",
          "last_event_time",
          "last_event_age_ms",
          "depth_sequence_gap_count"
