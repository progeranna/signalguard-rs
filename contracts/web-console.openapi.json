            "type": "number"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "trades_per_minute": {
            "nullable": true,
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "price",
          "spread_pct",
          "trades_per_minute",
          "last_event_age_ms"
        ],
        "type": "object"
      },
      "MarketTimelineResponse": {
        "additionalProperties": true,
        "properties": {
          "anomalies": {
            "items": {
              "$ref": "#/components/schemas/AnomalyResponse"
            },
            "type": "array"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/MarketTimelinePointResponse"
            },
            "type": "array"
          },
          "symbol": {
            "type": "string"
          }
        },
        "required": [
