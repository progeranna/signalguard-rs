          "state",
          "health"
        ],
        "type": "object"
      },
      "HealthPenalty": {
        "additionalProperties": true,
        "properties": {
          "anomaly_type": {
            "nullable": true,
            "type": "string"
          },
          "event_time": {
            "format": "date-time",
