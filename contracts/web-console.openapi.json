          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "score",
          "base_score",
          "status",
          "evaluated_at",
          "recent_anomaly_count",
          "signals",
          "penalties"
        ],
        "type": "object"
      },
      "MarketHealthSignals": {
        "additionalProperties": true,
        "properties": {
          "last_event_age_ms": {
