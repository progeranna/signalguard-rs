        "type": "object"
      },
      "DashboardSummaryResponse": {
        "additionalProperties": true,
        "properties": {
          "pipeline": {
            "$ref": "#/components/schemas/PipelineHealthResponse"
          },
          "recent_anomalies": {
            "items": {
              "$ref": "#/components/schemas/AnomalyResponse"
            },
            "type": "array"
          },
          "service": {
            "$ref": "#/components/schemas/HealthResponse"
          },
          "symbols": {
            "items": {
              "$ref": "#/components/schemas/DashboardSymbolSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "service",
          "pipeline",
          "symbols",
          "recent_anomalies"
