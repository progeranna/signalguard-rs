  "info": {
    "title": "SignalGuard web console API",
    "version": "0.4.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/anomalies": {
      "get": {
        "operationId": "getAnomalies",
        "parameters": [
          {
            "in": "query",
            "name": "symbol",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomaliesResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "operationId": "getDashboardSummary",
        "parameters": [
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "enum": [
                "demo",
                "live"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummaryResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/market/{symbol}/health": {
      "get": {
        "operationId": "getMarketHealth",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketHealthResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/market/{symbol}/state": {
      "get": {
        "operationId": "getMarketState",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketStateResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/market/{symbol}/timeline": {
      "get": {
        "operationId": "getMarketTimeline",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9]+$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "enum": [
                "demo",
                "live"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketTimelineResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/pipeline/health": {
      "get": {
        "operationId": "getPipelineHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineHealthResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/runtime/mode": {
      "get": {
        "operationId": "getRuntimeMode",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeModeResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      },
      "post": {
        "operationId": "postRuntimeMode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeModeSwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeModeResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/symbols": {
      "get": {
        "operationId": "getSymbols",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SymbolsResponse"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    }
  },
  "x-signalguard-metrics": {
    "contentType": "text/plain; version=0.0.4; charset=utf-8",
    "description": "Prometheus text endpoint; excluded from JSON schemas.",
    "method": "GET",
    "path": "/metrics"
  }
}
