        "additionalProperties": true,
        "properties": {
          "mode": {
            "enum": [
              "replay",
              "live"
            ],
            "type": "string"
          },
          "reset_state": {
            "type": "boolean"
          },
          "reset_storage": {
            "type": "boolean"
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
